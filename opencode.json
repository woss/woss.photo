{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vmcp": {
      "type": "remote",
      "url": "http://localhost:8000/private/general_localhost/vmcp",
      "enabled": true
    },
    "gitbutler": {
      "type": "local",
